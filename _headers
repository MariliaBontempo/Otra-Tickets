# Long-lived immutable cache for static, content-addressed assets.
# The * wildcard matches across "/", so /uploads/* also covers uploads/variants/*.
/uploads/*
  Cache-Control: public, max-age=31536000, immutable
/photos/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Private admin interface: keep it out of search and answer-engine indexes.
# Only Otra Guide Studio (prod and local http on any port) or the admin
# itself may frame it; staging and dev hosts are left out on purpose.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: frame-ancestors 'self' https://otraguide.com https://www.otraguide.com http://localhost:* http://127.0.0.1:*

# HTML: revalidate every load so deploys propagate immediately (never immutable).
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
